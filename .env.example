# ─────────────────────────────────────────────────────────────────────────────
# Copy to ".env" for local development:  cp .env.example .env
#
# The backend loads this file ONLY when it runs on a developer machine. In a deployment
# (Railway/Docker/Heroku) the file is ignored completely and the platform's environment
# variables are the only source of truth - that is what keeps a developer's tunnel URL from
# silently taking over production (see modules/runtime_env.py).
#
# Never commit the real .env: it holds secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the app itself lives ───────────────────────────────────────────────
# PUBLIC_BASE_URL is the app's own public URL. It is used for the email tracking pixels and
# as a fallback for the Twilio webhooks. In production this MUST be the deployed backend:
#   Production: PUBLIC_BASE_URL=https://crmbackend.serphawk.in
PUBLIC_BASE_URL="http://localhost:8000"

# ── Where Twilio fetches its TwiML from ──────────────────────────────────────
# VOICE_AGENT_BASE_URL overrides PUBLIC_BASE_URL for the voice agent only. Use it while
# developing locally, because Twilio cannot reach 127.0.0.1: point it at your ngrok tunnel.
#   Local:  VOICE_AGENT_BASE_URL=https://<subdomain>.ngrok-free.dev
#
# PRODUCTION: set it to the same public URL as PUBLIC_BASE_URL, or leave it unset. A stale
# value (a dead tunnel, an old deployment URL) is detected automatically - the backend
# verifies the address before every call and skips it when it does not serve this app - but
# pointing it at the right URL from the start keeps the logs clean.
# VOICE_AGENT_BASE_URL="https://crmbackend.serphawk.in"

# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The number the agent calls FROM (E.164). TWILIO_VOICE_NUMBER wins over TWILIO_PHONE_NUMBER.
TWILIO_PHONE_NUMBER="+18158890425"
# TWILIO_VOICE_NUMBER=""
# Validate the X-Twilio-Signature of every webhook (the token check always runs).
TWILIO_VALIDATE_WEBHOOKS="false"
# Default country code for numbers entered without one (e.g. 91 for India).
# VOICE_AGENT_DEFAULT_COUNTRY_CODE="91"

# ── Database / API keys ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
OPENAI_API_KEY=""
# FIRECRAWL_API_KEY=""
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET for the OAuth flows.

# ── Frontend ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL is read by the Next.js frontend (Vercel):
#   Production: NEXT_PUBLIC_API_BASE_URL=https://crmbackend.serphawk.in
# NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# NEXT_PUBLIC_WHATSAPP_NUMBER="919502901416"
# NEXT_PUBLIC_WHATSAPP_DISPLAY="+91 9502901416"
